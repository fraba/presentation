}

@article{vromenEverydayMakingFacebook2016,
  title = {Everyday Making through {{Facebook}} Engagement: {{Young}} Citizens' Political Interactions in {{Australia}}, the {{United Kingdom}} and the {{United States}}},
  shorttitle = {Everyday {{Making}} through {{Facebook Engagement}}},
  author = {Vromen, Ariadne and Loader, Brian D. and Xenos, Michael A. and Bailo, Francesco},
